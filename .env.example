# PulseNotify local environment — never commit this file.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-me

# PostgreSQL (docker-compose service)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pulsenotify
DB_USER=pulsenotify
DB_PASSWORD=pulsenotify
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker + result backend)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Where the Celery worker reaches Django's mock price feed.
INTERNAL_API_BASE=http://localhost:8000

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# How often Beat checks prices (seconds)
PRICE_CHECK_INTERVAL=60
